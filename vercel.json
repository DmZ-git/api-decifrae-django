{
  "buildCommand": "pip install -r requirements.txt",
  "functions": {
    "api/**": {
      "maxDuration": 30,
      "memory": 3008,
      "excludeFiles": "{.git/**,.github/**,.pytest_cache/**,__pycache__/**,*.pyc,*.pyo,node_modules/**,tests/**,*.md,.env*,.venv/**,venv/**,*.egg-info/**,dist/**,build/**,.coverage,htmlcov/**,*.sqlite3,.DS_Store,.idea/**,.vscode/**}"
    }
  },
  "env": {
    "PYTHONPATH": "/var/task"
  }
}
