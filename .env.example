# ============================================================================
# RENDER DEPLOYMENT CONFIGURATION
# Copy this file to .env in your Render environment
# ============================================================================

# Django Settings
SECRET_KEY=<generate-a-new-secret-key-with-50+-chars>
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com

# Database (Supabase PostgreSQL) - INCLUA ?sslmode=require NO FINAL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.jttksxgmlaztmeiomtfo.supabase.co:5432/postgres?sslmode=require

# Supabase Configuration (get from Settings > API)
SUPABASE_URL=https://jttksxgmlaztmeiomtfo.supabase.co
SUPABASE_SERVICE_KEY=[copiar de: Settings > API > Service Role Key]
SUPABASE_ANON_KEY=[copiar de: Settings > API > Anon Key]
SUPABASE_STORAGE_BUCKET=audio-files

# CORS & Frontend
FRONTEND_URL=https://front-decifrae.vercel.app
CORS_ALLOWED_ORIGINS=https://front-decifrae.vercel.app
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# Audio Processing
AUDIO_MAX_SIZE_MB=50
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# ===== CELERY & REDIS (Novo - Processamento Assíncrono) =====
# Obtenha do Render: Services → Redis → Connection String
CELERY_BROKER_URL=redis://red-d5o4q04hg0os73fcikrg:jlvWRa3lWenCFKSMw1Y7REcvbDN1EXSM@red-d5o4q04hg0os73fcikrg:6379/0
CELERY_RESULT_BACKEND=redis://red-d5o4q04hg0os73fcikrg:jlvWRa3lWenCFKSMw1Y7REcvbDN1EXSM@red-d5o4q04hg0os73fcikrg:6379/0

# Timeouts e Limites
CELERY_TASK_TIME_LIMIT=900
CELERY_TASK_SOFT_TIME_LIMIT=600

# Environment
ENVIRONMENT=production


# Logging
DJANGO_LOG_LEVEL=INFO