# =============================================================================
# RENDER DEPLOYMENT ENV VARS
# Copie para o Render (Web e Worker). Preencha os valores conforme indicado.
# =============================================================================

# --- Django ---
SECRET_KEY=<generate-50+-chars>
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com

# --- Database (Supabase/PostgreSQL) ---
# Inclua ?sslmode=require no final
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=[Service Role Key]
SUPABASE_ANON_KEY=[Anon Key]
SUPABASE_STORAGE_BUCKET=audio-files

# --- CORS / CSRF / Frontend ---
FRONTEND_URL=https://front-decifrae.vercel.app
CORS_ALLOWED_ORIGINS=https://front-decifrae.vercel.app
RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com
RENDER_EXTERNAL_URL=https://your-app.onrender.com

# --- Audio ---
AUDIO_MAX_SIZE_MB=50
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800

# --- Celery / Redis ---
# Se tiver Redis no Render (recomendado em produção):
CELERY_BROKER_URL=redis://user:pass@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://user:pass@redis-host:6379/0

# Se NAO tiver Redis, deixe CELERY_BROKER_URL vazio
# e garanta DATABASE_URL definido; o fallback usa o banco como broker/result.
# Exemplo (para forçar fallback):
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- Celery Limits ---
CELERYD_MAX_TASKS_PER_CHILD=10
CELERYD_TASK_SOFT_TIME_LIMIT=300
CELERYD_TASK_TIME_LIMIT=360
# Opcional: limite de memoria por child (kB)
CELERYD_MAX_MEMORY_PER_CHILD=400000

# --- Gunicorn (opcional, override) ---
# GUNICORN_CMD_ARGS=--workers=2 --timeout=30 --max-requests=100

# --- Logging ---
DJANGO_LOG_LEVEL=INFO

# --- Environment flag ---
ENVIRONMENT=production